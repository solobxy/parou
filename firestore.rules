rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidReport(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.type in ['ACIDENTE', 'ATRASOS', 'AVARIA', 'GREVE', 'OBRAS', 'CORTE', 'SERVICO_PUBLICO'] &&
        data.severity in ['Grave', 'Moderada', 'Informação'] &&
        data.district is string && data.district.size() > 0 && data.district.size() <= 100 &&
        data.status in ['Ativa', 'Em resolução', 'Resolvida', 'Em análise', 'Ocultada'] &&
        data.timestamp is number &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('concelho' in data) || (data.concelho is string && data.concelho.size() <= 100)) &&
        (!('locationDetails' in data) || (data.locationDetails is string && data.locationDetails.size() <= 250)) &&
        (!('companyOrService' in data) || (data.companyOrService is string && data.companyOrService.size() <= 100)) &&
        (!('reportedAt' in data) || (data.reportedAt is string && data.reportedAt.size() <= 100)) &&
        (!('upvotes' in data) || data.upvotes is number) &&
        (!('confirmationsCount' in data) || data.confirmationsCount is number) &&
        (!('unconfirmedCount' in data) || data.unconfirmedCount is number) &&
        (!('confirmedBy' in data) || data.confirmedBy is list) &&
        (!('unconfirmedBy' in data) || data.unconfirmedBy is list) &&
        (!('reportsCount' in data) || data.reportsCount is number) &&
        (!('reportedBy' in data) || data.reportedBy is list) &&
        (!('isCommunityVerified' in data) || data.isCommunityVerified is bool) &&
        (!('commentsCount' in data) || data.commentsCount is number) &&
        (!('imagesCount' in data) || data.imagesCount is number) &&
        (!('authorId' in data) || (data.authorId is string && data.authorId.size() <= 128)) &&
        (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
        (!('sourceName' in data) || (data.sourceName is string && data.sourceName.size() <= 150)) &&
        (!('sourceType' in data) || (data.sourceType is string && data.sourceType.size() <= 50)) &&
        (!('sourceUrl' in data) || (data.sourceUrl is string && data.sourceUrl.size() <= 500)) &&
        (!('sourceFetchedAt' in data) || data.sourceFetchedAt is number) &&
        (!('externalId' in data) || (data.externalId is string && data.externalId.size() <= 200));
    }

    function isValidComplaint(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.text is string && data.text.size() > 0 && data.text.size() <= 2000 &&
        data.companyOrService is string && data.companyOrService.size() > 0 && data.companyOrService.size() <= 100 &&
        data.district is string && data.district.size() > 0 && data.district.size() <= 100 &&
        data.timestamp is number &&
        data.isOpinion is bool &&
        (!('serviceType' in data) || (data.serviceType is string && data.serviceType.size() <= 50)) &&
        (!('rating' in data) || (data.rating is number && data.rating >= 1 && data.rating <= 5)) &&
        (!('concelho' in data) || (data.concelho is string && data.concelho.size() <= 100)) &&
        (!('locationDetails' in data) || (data.locationDetails is string && data.locationDetails.size() <= 200)) &&
        (!('incidentDate' in data) || (data.incidentDate is string && data.incidentDate.size() <= 50)) &&
        (!('status' in data) || (data.status in ['Pública', 'Respondida', 'Em análise', 'Ocultada'])) &&
        (!('commentsCount' in data) || data.commentsCount is number) &&
        (!('upvotes' in data) || data.upvotes is number) &&
        (!('upvotedBy' in data) || data.upvotedBy is list) &&
        (!('reportsCount' in data) || data.reportsCount is number) &&
        (!('reportedBy' in data) || data.reportedBy is list) &&
        (!('authorId' in data) || (data.authorId is string && data.authorId.size() <= 128)) &&
        (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100));
    }

    function isValidComplaintComment(data) {
      return data.complaintId is string && data.complaintId.size() > 0 && data.complaintId.size() <= 128 &&
        data.text is string && data.text.size() > 0 && data.text.size() <= 1000 &&
        data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100 &&
        data.timestamp is number &&
        (!('authorId' in data) || (data.authorId is string && data.authorId.size() <= 128));
    }

    function isValidUser(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
        data.reputationPoints is number &&
        (!('reportsCount' in data) || data.reportsCount is number) &&
        (!('badge' in data) || (data.badge is string && data.badge.size() <= 50)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('createdAt' in data) || data.createdAt is number);
    }

    // Reports collection - crowd-sourced traffic and transit occurrences in Portugal
    match /reports/{reportId} {
      allow read: if true;
      allow create: if isValidId(reportId) && isValidReport(request.resource.data);
      allow update: if isValidId(reportId) && isValidReport(request.resource.data);
      allow delete: if isValidId(reportId);
    }

    // Complaints collection - posts about companies, transport and public services
    match /complaints/{complaintId} {
      allow read: if true;
      allow create: if isValidId(complaintId) && isValidComplaint(request.resource.data);
      allow update: if isValidId(complaintId) && isValidComplaint(request.resource.data);
      allow delete: if isValidId(complaintId);

      // Subcollection for comments on complaints
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isValidId(commentId) && isValidComplaintComment(request.resource.data);
        allow update: if false;
        allow delete: if false;
      }
    }

    // Users collection - contributor profiles, reputation points and badges
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidUser(request.resource.data) &&
        (request.auth != null && request.auth.uid == userId);
      allow delete: if false;

      // User favorites subcollection (synced when logged in)
      match /favorites/{favId} {
        allow read, write: if isValidId(favId) && (request.auth != null && request.auth.uid == userId);
      }
    }
  }
}
